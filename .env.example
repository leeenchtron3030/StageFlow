# Backend service identity and logging
STAGEFLOW_SERVICE_ID=stageflow-backend
STAGEFLOW_SERVICE_NAME=StageFlow Backend
STAGEFLOW_API_VERSION=0.1.0
STAGEFLOW_LOG_LEVEL=INFO

# Required for protected API routes and the frontend Demo proxy; use 32+ characters.
STAGEFLOW_API_SHARED_SECRET=
STAGEFLOW_CORS_ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000

# Event-Mode Kernel composition and optional deployment overrides
STAGEFLOW_KERNEL_CONFIG_PATH=
STAGEFLOW_NODE_ROLE=
STAGEFLOW_EVENT_MODE=
STAGEFLOW_NETWORK_POLICY=

# Frontend data sources
STAGEFLOW_UI_DATA_MODE=fixture
STAGEFLOW_KERNEL_STATUS_URL=http://127.0.0.1:8000/api/v1/kernel/status
STAGEFLOW_MTE_API_BASE_URL=http://127.0.0.1:8000/api/v1
STAGEFLOW_DEMO_API_BASE_URL=http://127.0.0.1:8000/api/v1/demo

# Demo controller inputs; secrets remain blank and must never be committed.
STAGEFLOW_DEMO_CONFIG_PATH=
STAGEFLOW_DEMO_POSTGRES_DSN=
STAGEFLOW_DEMO_CUDA_RUNTIME_PATH=
STAGEFLOW_DEMO_OPERATOR_ID=
STAGEFLOW_DEMO_DEVCON_API_KEY=
